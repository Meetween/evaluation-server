
module load Miniconda3/23.3.1-0 &> /dev/null || module load miniconda3/23.5.2-0 &> /dev/null

eval "$(conda shell.bash hook)"

conda create -p ${PLG_GROUPS_STORAGE}/plggmeetween/envs/conda/bert -c conda-forge python=3.9 pip
conda activate  ${PLG_GROUPS_STORAGE}/plggmeetween/envs/conda/bert 

pip install evaluate
pip install scikit-learn
pip install bert_score

